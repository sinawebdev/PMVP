.env
.venv/
.render-cli/
__pycache__/
*.pyc
*.pyo
.pytest_cache/

instance/*
!instance/.gitkeep
uploads/*
!uploads/.gitkeep
exports/*
!exports/.gitkeep

cloudflared.log
*.log

# Real client payroll workbooks (contain employee PII/salary data) that ended
# up at repo root during debugging — never committed. The canonical copy for
# testing lives in uploads/ (already ignored above).
/acs 1.xlsx

# Test specimen workbooks (real client PII) — decrypted locally, never committed.
# Ignore the whole directory, not just *.xlsx: the specimens also arrive as .xls
# /.xlsm/.csv, and Excel drops ~$ lock files and decryption scratch alongside
# them. Only .gitkeep is tracked, so the directory exists for the skipUnless
# gates without any client data ever being committable.
tests/fixtures/*
!tests/fixtures/.gitkeep

# Design-review screenshots from scripts/capture_ui.py. Regenerated on demand,
# large, and binary — reviewed in a message or a PR, never committed.
.screenshots/
